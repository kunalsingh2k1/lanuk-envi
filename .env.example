# Copy this file to .env and fill it in. .env is never committed.

# Port the server listens on (127.0.0.1 only)
PORT=4777

# The Obsidian vault Envi reads and writes
VAULT_PATH=C:\AI OFFICE\LANUK OFFICE

# Supabase account 2, project lanuk-x
# Dashboard > Project Settings > API. Use the service_role key: it stays on this PC only.
SUPABASE_URL=https://vygpccghhhtxgzmlnwkx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Ollama on this PC
OLLAMA_URL=http://127.0.0.1:11434

# Google: Envi's own sign-in for the Apps switch (read + drafts). Steps: docs/SECURITY.md, "Connect Google".
# OAuth client type "Web application", redirect http://127.0.0.1:4777/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub MCP server (read-only). Fine-grained token you create: github.com/settings/personal-access-tokens
GITHUB_MCP_TOKEN=

# Local voice (Voice Studio, installed in C:\AI TOOLSoice-studio). Optional; these are the defaults.
# VOICE_STUDIO_URL=http://127.0.0.1:8880
# VOICE_STUDIO_ENGINE=kokoro
# VOICE_STUDIO_VOICE=af_heart
